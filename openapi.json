{
  "openapi": "3.1.0",
  "info": {
    "title": "Themis Batch Inference API",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/inference": {
      "post": {
        "summary": "Infer",
        "description": "Score up to 256 chats, returning one result per chat in input order.\n\nCategory and action probabilities are separate distributions. Each\nchat is truncated to the model's configured token limit. An empty\ninput array returns an empty array.",
        "operationId": "batchInference",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "type": "string",
                  "maxLength": 16384,
                  "minLength": 1
                },
                "type": "array",
                "maxItems": 256,
                "title": "Chats"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ChatScores"
                  },
                  "type": "array",
                  "title": "Response Batchinference"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatScores": {
        "properties": {
          "category": {
            "type": "string",
            "title": "Category"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "category_probabilities": {
            "additionalProperties": {
              "type": "number",
              "maximum": 1.0,
              "minimum": 0.0
            },
            "type": "object",
            "title": "Category Probabilities"
          },
          "action_probabilities": {
            "additionalProperties": {
              "type": "number",
              "maximum": 1.0,
              "minimum": 0.0
            },
            "type": "object",
            "title": "Action Probabilities"
          }
        },
        "type": "object",
        "required": [
          "category",
          "action",
          "category_probabilities",
          "action_probabilities"
        ],
        "title": "ChatScores"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
